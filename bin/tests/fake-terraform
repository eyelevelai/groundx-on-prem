#!/usr/bin/env bash

set -euo pipefail

printf '%s\n' "$*" >> "$FAKE_TERRAFORM_LOG"

if [[ "${FAKE_SCENARIO:-}" == "setup_eks" && "$1" == "-chdir="* ]]; then
  dir="${1#-chdir=}"
  case "${2:-}" in
    init|apply)
      exit 0
      ;;
    plan)
      count=$(find "$FAKE_TFVARS_SNAPSHOTS" -type f | wc -l | tr -d ' ')
      cp "$dir/../env.tfvars" "$FAKE_TFVARS_SNAPSHOTS/$(printf '%02d' $((count + 1)))-$(basename "$dir").tfvars"
      exit 0
      ;;
    show)
      printf '%s' '{"format_version":"1.0"}'
      exit 0
      ;;
    output)
      case "${3:-} ${4:-}" in
        "-raw vpc_id") printf 'vpc-0test'; exit 0 ;;
        "-json subnets") printf '["subnet-0test"]'; exit 0 ;;
        "-raw ssh_security_group") printf 'sg-0test'; exit 0 ;;
        "-raw storage_driver") printf 'ebs'; exit 0 ;;
        "-raw storage_class_name") printf 'eyelevel-pv'; exit 0 ;;
        "-raw storage_access_mode") printf 'ReadWriteOnce'; exit 0 ;;
        "-raw efs_file_system_id") exit 0 ;;
      esac
      ;;
  esac
fi

if [[ "$1" == "-chdir="* && "$2" == "show" && "$3" == "-json" ]]; then
  case "$FAKE_SCENARIO" in
    existing_cluster|existing_cluster_lookup_fails)
      printf '%s' '{"format_version":"1.0","values":{"root_module":{"resources":[],"child_modules":[{"address":"module.eyelevel_eks","resources":[],"child_modules":[{"address":"module.eyelevel_eks.module.eks","resources":[{"address":"module.eyelevel_eks.module.eks.aws_eks_cluster.this[0]","type":"aws_eks_cluster","values":{"name":"eyelevel_abc123","version":"1.31"}}]}]}]}}}'
      exit 0
      ;;
    not_yet_created)
      printf '%s' '{"format_version":"1.0"}'
      exit 0
      ;;
    state_read_fails)
      echo "Error: Terraform state not initialized. Run \"terraform init\" in this directory." >&2
      exit 1
      ;;
  esac
  exit 1
fi

echo "unexpected terraform invocation: $*" >&2
exit 2
