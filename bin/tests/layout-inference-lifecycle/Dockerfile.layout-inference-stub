FROM python:3.11-slim
RUN pip install --no-cache-dir supervisor celery redis
WORKDIR /app
COPY stub/init-layout.py /app/init-layout.py
COPY stub/document /app/document
COPY stub/document_monitor.py /app/document_monitor.py
COPY stub/document_health.py /app/document_health.py
ARG INIT_LAYOUT_SLEEP=60
ARG INIT_LAYOUT_EXIT=
ENV BROKER_URL=redis://redis:6379/0
ENV RESULT_URL=redis://redis:6379/1
ENV INIT_LAYOUT_SLEEP=${INIT_LAYOUT_SLEEP}
ENV INIT_LAYOUT_EXIT=${INIT_LAYOUT_EXIT}
