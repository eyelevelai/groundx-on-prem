#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
FAKE_TERRAFORM="$ROOT_DIR/bin/tests/fake-terraform"
FAKE_AWS="$ROOT_DIR/bin/tests/fake-aws"

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

TEST_ROOT=$(mktemp -d)
trap 'rm -rf "$TEST_ROOT"' EXIT

run_scenario() {
  local scenario="$1"
  local run_dir="$TEST_ROOT/$scenario"
  mkdir -p "$run_dir/bin" "$run_dir/env"
  ln -s "$FAKE_TERRAFORM" "$run_dir/bin/terraform"
  ln -s "$FAKE_AWS" "$run_dir/bin/aws"

  set +e
  (
    FAKE_SCENARIO="$scenario" \
      FAKE_TERRAFORM_LOG="$run_dir/terraform.log" \
      FAKE_AWS_LOG="$run_dir/aws.log" \
      PATH="$run_dir/bin:$PATH" \
      bash -c '. "'"$ROOT_DIR"'/bin/shared/util"; resolve_eks_version "'"$run_dir/env"'" "1.35"'
  ) >"$run_dir/stdout" 2>"$run_dir/stderr"
  echo $? > "$run_dir/exit_code"
  set -e
}

run_scenario existing_cluster
[[ "$(cat "$TEST_ROOT/existing_cluster/exit_code")" == "0" ]] || fail "existing-cluster resolution should succeed"
existing_result=$(cat "$TEST_ROOT/existing_cluster/stdout")
[[ "$existing_result" == "1.31" ]] || fail "expected the existing cluster's actual running version (1.31), got [$existing_result]"

run_scenario not_yet_created
[[ "$(cat "$TEST_ROOT/not_yet_created/exit_code")" == "0" ]] || fail "not-yet-created resolution should succeed"
not_created_result=$(cat "$TEST_ROOT/not_yet_created/stdout")
[[ "$not_created_result" == "1.35" ]] || fail "expected the declared default (1.35) for a not-yet-created cluster, got [$not_created_result]"

run_scenario existing_cluster_lookup_fails
lookup_fail_exit=$(cat "$TEST_ROOT/existing_cluster_lookup_fails/exit_code")
[[ "$lookup_fail_exit" != "0" ]] || fail "an existing cluster whose version lookup fails must exit non-zero, not silently fall back to the declared default"
lookup_fail_result=$(cat "$TEST_ROOT/existing_cluster_lookup_fails/stdout")
[[ "$lookup_fail_result" != "1.35" ]] || fail "an existing cluster whose version lookup fails must never emit the declared default (1.35) -- that is the unattended-downgrade risk this function exists to prevent"
[[ -z "$lookup_fail_result" ]] || fail "an existing cluster whose version lookup fails must not emit any version on stdout, got [$lookup_fail_result]"

echo "resolve-eks-version tests passed"
