        matchLabels:
          app: groundx
      template:
        metadata:
          annotations:
            config-hash: cfb203ed1c67394109b360339a678b029095687c5bbb31cfbeac16582db07667
          labels:
            app: groundx
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-cpu-only
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-cpu-only
          containers:
            - image: public.ecr.aws/c9r4x6y5/eyelevel/groundx:0.1.0
              imagePullPolicy: IfNotPresent
