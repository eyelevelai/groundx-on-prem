  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app: groundx
        appVersion: 0.1.0
        chart: groundx-0.1.0
        heritage: Helm
        version: 0.1.0
      name: groundx
      namespace: eyelevel
    spec:
      replicas: 1
