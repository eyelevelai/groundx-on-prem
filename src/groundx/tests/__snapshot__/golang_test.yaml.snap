                  readOnly: true
                  subPath: config.yaml
          nodeSelector:
            disktype: ssd
          restartPolicy: Never
          securityContext:
            fsGroup: 2000
          serviceAccountName: other-service-account
          tolerations:
            - effect: NoSchedule
              key: workload-type
              operator: Equal
              value: batch
