        version: 0.1.0
      name: RELEASE-NAME-schema-migration
      namespace: eyelevel
    spec:
      activeDeadlineSeconds: 900
      backoffLimit: 0
      template:
        metadata:
          annotations:
            prometheus.io/port: "8081"
          labels:
            app: RELEASE-NAME-schema-migration
            app.kubernetes.io/name: myapp
        spec:
          affinity:
            requiredDuringSchedulingIgnoredDuringExecution:
              - labelSelector:
                  matchExpressions:
                    - key: app
                      operator: In
                      values:
                        - myapp
                topologyKey: kubernetes.io/hostname
          containers:
            - args:
                - -migrate-only
              image: test.image:v1
              imagePullPolicy: Never
              name: migrate
              resources:
