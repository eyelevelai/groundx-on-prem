            config-hash: 155a8c0fe9d3f3a8f6c39e210e3e6813515ad5f552d0df33fb9eecba8ef22b3c
          labels:
            app: groundx
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-cpu-only
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-cpu-only
          containers:
            - image: public.ecr.aws/c9r4x6y5/eyelevel/groundx:0.1.0
              imagePullPolicy: IfNotPresent
