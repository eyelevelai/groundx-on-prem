ebhookServer:\n  baseURL: http://layout-webhook.eyelevel.svc.cluster.local\n  port: 8080\n  serviceName: layout-webhook\n\nmetrics:\n  active: true\n  api:\n    - name: groundx\n      threshold: 4000\n    - name: layout-api\n      threshold: 4000\n    - name: layout-webhook\n      threshold: 4000\n    - name: ranker-api\n      threshold: 4000\n  document:\n    tokensPerMinute: 12500\n  extractRequest:\n    tokensPerMinute: 6000\n  inference:\n    - name: layout-inference\n      tokensPerMinute: 360000\n    - name: summary-api\n      tokensPerMinute: 9600\n    - name: summary-inference\n      tokensPerMinute: 1600\n    - name: summary-client\n      tokensPerMinute: 9600\n  namespace: eyelevel\n  page:\n    tokensPerMinute: 1000\n  queue:\n    - name: pre-process\n      target: pre-process\n      threshold: 10\n    - name: process\n      target: process\n      threshold: 10\n    - name: queue\n      target: queue\n      threshold: 10\n    - name: upload\n      target: upload\n      threshold: 10\n  session:\n    addr: cache-metrics.eyelevel.svc.cluster.local:6379\n    notCluster: true\n    ssl: false\n  \n  summaryRequest:\n    tokensPerMinute: 625\n  task:\n    - name: layout-correct\n      target: correct_queue\n      threshold: 10\n    - name: layout-map\n      target: map_queue\n      threshold: 10\n    - name: layout-ocr\n      target: ocr_queue\n      threshold: 10\n    - name: layout-process\n      target: process_queue\n      threshold: 10\n    - name: layout-save\n      target: save_queue,celery\n      threshold: 10\n    - name: ranker-inference\n      session: ranker\n      target: inference_queue\n      threshold: 10\n  throughput:\n    - name: groundx\n      tokensPerMinute: 150000\n    - name: layout-api\n      tokensPerMinute: 180000\n    - name: layout-correct\n      tokensPerMinute: 100000\n    - name: layout-inference\n      tokensPerMinute: 360000\n    - name: layout-map\n      tokensPerMinute: 100000\n    - name: layout-ocr\n      tokensPerMinute: 100000\n    - name: layout-process\n      tokensPerMinute: 100000\n    - name: layout-save\n      tokensPerMinute: 150000\n    - name: layout-webhook\n      tokensPerMinute: 150000\n    - name: pre-process\n      tokensPerMinute: 100000\n    - name: process\n      tokensPerMinute: 150000\n    - name: queue\n      tokensPerMinute: 100000\n    - name: ranker-api\n      tokensPerMinute: 270000\n    - name: ranker-inference\n      tokensPerMinute: 840000\n    - name: summary-api\n      tokensPerMinute: 9600\n    - name: summary-inference\n      tokensPerMinute: 1600\n    - name: summary-client\n      tokensPerMinute: 9600\n    - name: upload\n      tokensPerMinute: 100000\n\nowner:\n  baseURL: http://groundx.eyelevel.svc.cluster.local/api/v1\n  name: on-prem\n  type: all\n  username: 00000000-0000-0000-0000-000000000000\n\npreProcessFileServer:\n  baseURL: http://pre-process.eyelevel.svc.cluster.local:8080\n  maxConcurrent: 4\n  port: 8080\n  serviceName: pre-process\n\nprocessFileServer:\n  baseURL: http://process.eyelevel.svc.cluster.local:8080\n  maxConcurrent: 4\n  port: 8080\n  serviceName: process\n\nprocessors:\n  convert: [11]\n  extract: [13]\n  layout: [3]\n  map: [4]\n  saveFile: [2]\n  skipConvert: [12]\n  skipGenerate: [1]\n  skipLayout: [5]\n  skipMap: [6]\n  skipSummarize: [7]\n  summarize: [8]\n  summarizeChunks: [10]\n  summarizeSections: [9]\n\nqueueFileServer:\n  baseURL: http://queue.eyelevel.svc.cluster.local:8080\n  maxConcurrent: 4\n  pollTime: 1\n  port: 8080\n  serviceName: queue\n\nqueues:\n  filePreProcess:\n    broker: stream-cluster-kafka-bootstrap.eyelevel.svc.cluster.local:9092\n    groupId: file-pre-process\n    topic: file-pre-process\n    type: kafka\n  fileProcess:\n    broker: stream-cluster-kafka-bootstrap.eyelevel.svc.cluster.local:9092\n    groupId: file-process\n    topic: file-process\n    type: kafka\n  fileSummaryDev:\n    broker: stream-cluster-kafka-bootstrap.eyelevel.svc.cluster.local:9092\n    groupId: file-summary\n    topi