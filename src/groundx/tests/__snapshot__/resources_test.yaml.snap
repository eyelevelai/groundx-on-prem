'extract.ingest: resources':
  1: |
    apiVersion: v1
    data:
      config_models.py: |
        env = dict(
          summary = dict(
            dtype = "bfloat16",
            maxInputTokens = 100000,
            maxOutputTokens = 4096,
            maxRequests = 1,
            name = "google/gemma-3-4b-it",
            swapSpace = 16,
          ),
