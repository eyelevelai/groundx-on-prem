                  value: /etc/ssl/tls/tls.crt
                - name: TLS_KEY_FILE
                  value: /etc/ssl/tls/tls.key
                - name: TLS_CA_FILE
                  value: /etc/ssl/tls/ca.crt
                - name: LISTEN_PORT
                  value: "8443"
