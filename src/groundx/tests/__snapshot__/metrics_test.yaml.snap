      template:
        metadata:
          annotations:
            config-hash: 89037875f8578c6f32dcb164ae8f6d2caaaa0fdbc89cafe287f0be55264e0bd2
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-gpu
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-gpu
