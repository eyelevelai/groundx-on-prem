        heritage: Helm
        version: 0.1.0
      name: metrics
      namespace: eyelevel
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: metrics
      template:
        metadata:
          annotations:
            config-hash: 2b1535b7b02a73624fc38292f407939f611df0cf362ecec048b6097c34a1207e
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-cpu-only
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-cpu-only
          containers:
