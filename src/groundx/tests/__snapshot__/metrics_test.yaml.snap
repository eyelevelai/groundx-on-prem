              image: public.ecr.aws/c9r4x6y5/eyelevel/busybox:1.0.0
              imagePullPolicy: Always
              name: wait-for-database
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
