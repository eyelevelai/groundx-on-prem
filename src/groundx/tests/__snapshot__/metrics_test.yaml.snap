                  value: /etc/ssl/tls/tls.crt
                - name: TLS_KEY_FILE
                  value: /etc/ssl/tls/tls.key
                - name: TLS_CA_FILE
                  value: /etc/ssl/tls/ca.crt
                - name: LISTEN_PORT
                  value: "8443"
              envFrom:
                - secretRef:
                    name: eyelevel-secret-credentials
              image: public.ecr.aws/c9r4x6y5/eyelevel/metrics:0.1.0
              imagePullPolicy: IfNotPresent
