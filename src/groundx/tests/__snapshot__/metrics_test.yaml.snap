      name: metrics
      namespace: eyelevel
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: metrics
      template:
        metadata:
          annotations:
            config-hash: 16232500528221b7ff40944313441ed2f9590f21b1b73c55b8836d5d735755dc
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-gpu
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-gpu
          containers:
            - env:
                - name: POD_NAMESPACE
