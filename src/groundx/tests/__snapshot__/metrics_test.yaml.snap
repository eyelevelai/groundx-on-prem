                  scheme: HTTPS
                initialDelaySeconds: 30
                periodSeconds: 30
              name: metrics
              ports:
                - containerPort: 8443
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /health
                  port: 8443
                  scheme: HTTPS
                initialDelaySeconds: 10
                periodSeconds: 30
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
