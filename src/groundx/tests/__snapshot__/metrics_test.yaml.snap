        metadata:
          annotations:
            config-hash: 41def579d9add797481749a8724dca0f5f94fd1bf198c366c65494c5bffbdb3b
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-gpu
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-gpu
