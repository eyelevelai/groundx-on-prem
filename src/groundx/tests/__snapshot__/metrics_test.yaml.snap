          tolerations:
            - effect: NoSchedule
              key: node
              value: eyelevel-gpu
            - effect: NoSchedule
              key: eyelevel_node
              value: eyelevel-gpu
          volumes:
            - name: config-volume
              secret:
                secretName: config-yaml-map
            - name: tls-volume
              secret:
                secretName: metrics-tls
