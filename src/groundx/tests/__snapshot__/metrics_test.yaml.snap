      template:
        metadata:
          annotations:
            config-hash: c5d5786895b9ee6df05dfd5bd21827f9aee8eb390096de14938cd06a018ac296
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-gpu
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-gpu
