    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app: metrics
        appVersion: 0.1.0
        chart: groundx-0.1.0
        heritage: Helm
        version: 0.1.0
      name: metrics
      namespace: eyelevel
    spec:
      replicas: 1
      selector:
        matchLabels:
          app: metrics
      template:
        metadata:
          annotations:
            config-hash: 5cd4f8377de2939ad4f2940508a26685b9092f4ec2dcd6fc35d16b2739ef04eb
          labels:
            app: metrics
        spec:
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: node
                        operator: In
                        values:
                          - eyelevel-cpu-only
                  - matchExpressions:
                      - key: eyelevel_node
                        operator: In
                        values:
                          - eyelevel-cpu-only
          containers:
            - env:
