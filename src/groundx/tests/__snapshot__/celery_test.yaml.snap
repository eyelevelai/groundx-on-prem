            supervisord-hash: 64861f085534e94eab9679d4f0765de4e6822eea933ed51e5f89de4ee6ef588a
          labels:
            app: myapp-process
        spec:
          containers:
            - command:
                - /bin/sh
                - -c
                - |
                  export PYTHONPATH=/app && exec supervisord -c /app/supervisord.conf
              env:
                - name: POD_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.name
                - name: LAYOUT_RENDER_DISK_BUDGET_MIB
                  value: "2048"
