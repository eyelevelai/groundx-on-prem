                    - ps aux | grep 'document.celery_process.app' | grep -v grep || exit 1
                initialDelaySeconds: 30
                periodSeconds: 30
              name: myapp-correct
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - ps aux | grep 'document.celery_process.app' | grep -v grep || exit 1
                initialDelaySeconds: 10
                periodSeconds: 30
              resources:
                requests:
                  cpu: 1
                  memory: 1Gi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
