              value: eyelevel-cpu-only
          volumes:
            - configMap:
                name: ranker-config-py-map
              name: config-volume
            - configMap:
                name: ranker-gunicorn-conf-py-map
              name: gunicorn-conf-volume
  4: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app: ranker-api
      name: ranker-api
      namespace: eyelevel
    spec:
      ports:
        - port: 80
