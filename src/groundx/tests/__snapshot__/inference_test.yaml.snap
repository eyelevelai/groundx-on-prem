                  name: host-usr-bin
            - command:
                - /bin/sh
                - -c
                - |
                  download_and_extract_model() {
                    echo "Model downloading started..."

                    touch /app/hf_models_cache/downloading

                    echo "" | tr ' ' '\n' | xargs -n 1 -P 5 -I {} sh -c \
                      'MAX_RETRIES=3; RETRIES=0; SUCCESS=0; PART={}; URL=https://upload.groundx.ai/layout/model/current/.tar.gz.part.$PART; \
                      while [ $RETRIES -lt $MAX_RETRIES ]; do \
                        echo "Download [attempt $RETRIES] layout.tar.gz.part.$PART"; \
                        wget -q -O /app/hf_models_cache/layout.tar.gz.part.$PART $URL && { echo "Downloaded layout.tar.gz.part.$PART successfully."; SUCCESS=1; break; }; \
                        echo "Failed to download $URL. Retrying..."; RETRIES=$((RETRIES + 1)); sleep 3; \
                      done; \
                      [ $SUCCESS -eq 0 ] && { echo "Failed to download $URL after $MAX_RETRIES attempts. Exiting."; rm /app/hf_models_cache/downloading; exit 1; }; \
                      echo "Unzipping layout.tar.gz.part.$PART..."; tar -xzf /app/hf_models_cache/layout.tar.gz.part.$PART -C /app/hf_models_cache/; echo "Unzipping layout.tar.gz.part.$PART complete...";'

                    rm /app/hf_models_cache/layout.tar.*
                    rm /app/hf_models_cache/downloading
                    touch /app/hf_models_cache/complete.
                  }
                  if [ ! -f /app/hf_models_cache/complete. ]; then
                    if [ ! -f /app/hf_models_cache/downloading ]; then
                      download_and_extract_model
                    else
                      echo "Download in progress by another pod. Waiting..."
                      while [ -f /app/hf_models_cache/downloading ] || [ ! -f /app/hf_models_cache/complete. ]; do
                        sleep $((3 + RANDOM % 2))
                      done

                      if [ ! -f /app/hf_models_cache/complete. ]; then
                        download_and_extract_model
                      else
                        echo "Model cache ready."
                      fi
                    fi
                  else
                    echo "Model cache already exists. Skipping download."
                  fi

                  echo "Model load done."
