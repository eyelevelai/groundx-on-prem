                runAsNonRoot: true
                runAsUser: 1001
                seccompProfile:
                  type: RuntimeDefault
              volumeMounts:
                - mountPath: /workspace/config_models.py
                  name: config-models
                  subPath: config_models.py
                - mountPath: /workspace/config.py
