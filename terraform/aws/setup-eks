#!/usr/bin/env bash

ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
do="$ENV_DIR/../../bin/environment"

. "$ENV_DIR/../../bin/shared/cli-input"
. "$ENV_DIR/../../bin/shared/util"

echo $ENV_DIR

must_have aws
must_have terraform
must_have jq

had_env_tfvars=false
if [ -f "$ENV_DIR/env.tfvars" ]; then
    had_env_tfvars=true
fi

if [ ! -f "$ENV_DIR/env.tfvars" ]; then
    echo "env.tfvars not found. Copying env.tfvars.example..."
    cp "$ENV_DIR/env.tfvars.example" "$ENV_DIR/env.tfvars"
fi

environments=("aws")
aws_clusters=("eks")
storage_options=("efs - EFS shared filesystem (recommended)" "ebs - EBS block volumes")

check_env=false
check_vpc=false
check_kc=false
check_kct=false

ENV="aws"
VPC=true
KC=true
KCT="eks"
REGION="us-east-2"
SEARCH=${SEARCH:-true}
STORAGE_DRIVER=${STORAGE_DRIVER:-}

choose_cluster_existing=$(prompt_menu "What type of Kubernetes cluster do you have?" "aws_clusters[@]")
choose_cluster_new=$(prompt_menu "What type of Kubernetes cluster do you want to set up?" "aws_clusters[@]")
choose_environment=$(prompt_menu "What hosting environment do you want to deploy to?" "environments[@]")
choose_storage=$(prompt_menu "What AWS persistent storage should this EKS install use?" "storage_options[@]")
choose_kc=$(prompt_text "Do you want to set up a dedicated Kubernetes cluster for this deployment?")
choose_vpc=$(prompt_text "Do you want to set up a dedicated VPC for this deployment?")
confirm_choices=$(prompt_text "")
enter_region=$(prompt_text "What AWS region do you want to deploy to?")
enter_access_cidrs=$(prompt_text "Which internet addresses may manage this cluster?

Your cluster has a control address that tools like kubectl and helm use to manage it.
Only the addresses you list here can reach it. Everyone else is refused.

Include the public address of THIS computer, because this script and the GroundX
install that follows manage the cluster from here. If you leave it out, this computer
is locked out. To find it, ask your network administrator, or search the web for
\"what is my IP address\" on this computer.

Write each address with /32 at the end, for example 203.0.113.5/32. To allow a whole
office network, use its range, for example 203.0.113.0/24. Separate several with commas.
This answer is saved as cluster_endpoint_public_access_cidrs in terraform/aws/env.tfvars.")
enter_s3_buckets=$(prompt_text "Which S3 buckets will GroundX store files in?

GroundX can read and write only the buckets you list here. List every bucket this
install uses: the main file bucket and, if document extraction uses its own bucket,
that bucket too. Type bucket names only, for example groundx-files, separated by commas.

Press Enter without typing anything if this install keeps its files inside the cluster
(the GroundX default) and uses no S3 bucket. GroundX then gets no S3 access.

In your GroundX Helm values these are file.bucketName and, if set, extract.file.bucketName.
This answer is saved as app_irsa_s3_buckets in terraform/aws/env.tfvars.")
enter_sqs_queues=$(prompt_text "Which SQS queues will GroundX use?

GroundX can use only the queues you list here. List every queue this install has
turned on, including the post-process queue and the large-file queue if you use them.
Type queue names only, for example file-process, separated by commas. The queues must
be in this AWS account and in the region you choose next.

Press Enter without typing anything if this install uses the built-in Kafka queues
(the GroundX default) and no SQS queue. GroundX then gets no SQS access.

In your GroundX Helm values each queue is the last part of a stream.topics.<name>.url
whose type is sqs. This answer is saved as app_irsa_sqs_queues in terraform/aws/env.tfvars.")

if $check_env; then
    ENV=$(prompt_input "menu" "$choose_environment" "environments[@]" "") && ok
fi

msg=$(status "Allowed addresses")
refused=$(status "Enter at least one address with /32 at the end, like 203.0.113.5/32 (separate several with commas)")
access_cidrs_hcl=$(prompt_input "cidr-list" "$enter_access_cidrs" "empty[@]" "$msg" "$refused") && ok

msg=$(status "S3 bucket names (Enter for none)")
refused=$(status "Use bucket names only, like groundx-files (no s3:// and no slashes), separated by commas. Enter for none")
s3_buckets_hcl=$(prompt_input "name-list" "$enter_s3_buckets" "empty[@]" "$msg" "$refused") && ok

msg=$(status "SQS queue names (Enter for none)")
refused=$(status "Use queue names only, like file-process (no https:// address), separated by commas. Enter for none")
sqs_queues_hcl=$(prompt_input "name-list" "$enter_sqs_queues" "empty[@]" "$msg" "$refused") && ok

list_display() {
    local items="${1//\"/}"
    items="${items#\[}"
    items="${items%\]}"
    if [[ -z "$items" ]]; then
        echo "$2"
    else
        echo "$items"
    fi
}

current_setting() {
    if grep -Eq "^[[:space:]]*$1[[:space:]]*=" "$ENV_DIR/env.tfvars"; then
        echo "as set in your current env.tfvars"
    else
        echo "$2 (no $1 setting)"
    fi
}

if $had_env_tfvars; then
    cat <<EOF

This folder already has an env.tfvars file, so GroundX may already be installed from it.
Continuing rewrites env.tfvars and changes this install's AWS access:

  S3 buckets GroundX can use
    now:   $(current_setting app_irsa_s3_buckets "every bucket in this AWS account")
    after: $(list_display "$s3_buckets_hcl" "none (no S3 access)")
  SQS queues GroundX can use
    now:   $(current_setting app_irsa_sqs_queues "every queue in this AWS account")
    after: $(list_display "$sqs_queues_hcl" "none (no SQS access)")
  Addresses that can manage the cluster
    now:   $(current_setting cluster_endpoint_public_access_cidrs "any address on the internet")
    after: $(list_display "$access_cidrs_hcl" "none")

If a bucket or queue this install uses is missing, GroundX will fail with "access denied" errors.
If this computer's public address is missing, this computer loses access to the cluster.

Type yes to continue. Anything else stops without changing anything.
EOF
    confirm_existing=""
    read -r -p "Continue? " confirm_existing
    confirm_existing=$(printf '%s' "$confirm_existing" | tr '[:upper:]' '[:lower:]' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    if [[ "$confirm_existing" != "yes" ]]; then
        echo "Stopped. Nothing was changed."
        exit 1
    fi
fi

if [[ "$ENV" == "aws" ]]; then
    test_aws || { error "aws command isn't working (are you logged in and authorized?)"; exit 2; }
fi

if $check_vpc; then
    VPC=$(prompt_input "yn" "$choose_vpc" "empty[@]" "") && ok
fi

if $check_kc && ! $VPC; then
    KC=$(prompt_input "yn" "$choose_kc" "empty[@]" "") && ok
else
    KC=true
fi

if $check_kct; then
    if $KC; then
        KCT=$(prompt_input "menu" "$choose_cluster_new" "aws_clusters[@]" "") && ok
    else
        KCT=$(prompt_input "menu" "$choose_cluster_existing" "aws_clusters[@]" "") && ok
    fi
fi

if [[ "$ENV" == "aws" ]]; then
    msg=$(status "Enter your region (e.g. us-east-2)")
    REGION=$(prompt_input "aws-region" "$enter_region" "empty[@]" "$msg") && ok
fi

if [[ -z "$STORAGE_DRIVER" ]]; then
    selected_storage=$(prompt_input "menu" "$choose_storage" "storage_options[@]" "") && ok
    STORAGE_DRIVER="${selected_storage%% *}"
fi

if [[ "$STORAGE_DRIVER" != "efs" && "$STORAGE_DRIVER" != "ebs" ]]; then
    error "Invalid STORAGE_DRIVER [$STORAGE_DRIVER]. Use efs or ebs." && echo ""
    exit 1
fi

echo "" && echo ""
echo "Please confirm your deployment settings:" && echo ""
echo -e   "deploying to:        $ENV"
if [[ "$REGION" != "" ]]; then
  echo -e "  region:            $REGION"
fi
if $VPC; then
    ok    "creating a VPC:      "
else
    error "creating a VPC:      "
fi
if $KC; then
    ok    "creating a cluster:  "
else
    error "creating a cluster:  "
fi
echo -e   "cluster type:        $KCT"
echo -e   "storage driver:      $STORAGE_DRIVER"
echo -e   "S3 buckets:          $(list_display "$s3_buckets_hcl" "none")"
echo -e   "SQS queues:          $(list_display "$sqs_queues_hcl" "none")"
echo -e   "API addresses:       $(list_display "$access_cidrs_hcl" "none")"


result=$(prompt_input "yn" "$confirm_choices" "empty[@]" "") && ok

if ! $result; then
    echo "Cancelling deployment."
    exit 1
fi


vpc_id=""
subnets="[]"
ssh_security_group=""
role_arns="[$ARN]"
ssh_key="$SSH_KEY"

if $KC; then
    status "testing EKS cluster configuration"

    # EKS_VERSION_GUARD_BEGIN
    eks_version=$(resolve_setup_eks_version "$ENV_DIR" "$REGION") || {
        error "Unable to determine the target EKS cluster version. Aborting rather than risking an unattended downgrade (see the warning above for the reason)." && echo ""
        exit 1
    }
    # EKS_VERSION_GUARD_END

    cat <<EOF > "$ENV_DIR/env.tfvars"
environment = {
  cluster_role_arns = $role_arns
  region = "$REGION"
  security_groups = [$ssh_security_group]
  ssh_key_name = "$ssh_key"
  stage = "prod"
  subnets = $subnets
  vpc_id = "$vpc_id"
}

environment_internal = {
  eks_version = "$eks_version"
}

storage = {
  driver = "$STORAGE_DRIVER"
}

app_irsa_s3_buckets                  = $s3_buckets_hcl
app_irsa_sqs_queues                  = $sqs_queues_hcl
cluster_endpoint_public_access_cidrs = $access_cidrs_hcl
EOF
fi

if $VPC; then
    status "testing VPC configuration"
    "$do" "$ENV-vpc" "-t" 2>&1 | tee tf_output.log

    if [[ $? -ne 0 ]]; then
        error "Terraform apply failed. Check tf_output.log for details." && echo ""
        exit 1
    fi

    cleaned_log=$(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log)

    if echo "$cleaned_log" | grep -Eq "Warning|Error"; then
        error "Terraform apply encountered warnings and/or errors. Check tf_output.log for details." && echo ""
        exit 1
    fi
    if grep -q "Warning" <(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log); then
        error "Terraform apply encountered warnings. Check tf_output.log for details." && echo ""
        exit 1
    fi

    ok && echo ""
    status "creating VPC" && echo ""

    "$do" "$ENV-vpc" 2>&1 | tee tf_output.log

    if [[ $? -ne 0 ]]; then
        error "Terraform apply failed. Check tf_output.log for details." && echo ""
        exit 1
    fi

    cleaned_log=$(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log)

    if echo "$cleaned_log" | grep -Eq "Warning|Error"; then
        error "Terraform apply encountered warnings and/or errors. Check tf_output.log for details." && echo ""
        exit 1
    fi
    if grep -q "Warning" <(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log); then
        error "Terraform apply encountered warnings. Check tf_output.log for details." && echo ""
        exit 1
    fi

    vpc_id=$(terraform -chdir="$ENV_DIR/vpc" output -raw vpc_id 2>/dev/null)
    if [[ -z "$vpc_id" ]]; then
        terraform -chdir="$ENV_DIR/vpc" output -raw vpc_id
        error "vpc_id is empty or not defined." && echo ""
        exit 1
    fi
    if [[ "$vpc_id" == *"Warning"* || "$vpc_id" == *"Error"* ]]; then
        error "$vpc_id"
        exit 1
    fi

    subnets=$(terraform -chdir="$ENV_DIR/vpc" output -json subnets 2>/dev/null)
    if [[ -z "$subnets" ]]; then
        terraform -chdir="$ENV_DIR/vpc" output -json subnets
        error "subnets is empty or not defined." && echo ""
        exit 1
    fi
    if [[ "$subnets" == *"Warning"* || "$subnets" == *"Error"* ]]; then
        error "$subnets"
        exit 1
    fi

    sg=$(terraform -chdir="$ENV_DIR/vpc" output -raw ssh_security_group 2>/dev/null)
    if [[ -z "$sg" ]]; then
        terraform -chdir="$ENV_DIR/vpc" output -raw ssh_security_group
        error "ssh_security_group is empty or not defined." && echo ""
        exit 1
    fi
    if [[ "$sg" == *"Warning"* || "$sg" == *"Error"* ]]; then
        error "$sg"
        exit 1
    fi

    ssh_security_group="\"$sg\""

    ok && echo ""
fi

if $KC; then
    status "testing EKS cluster configuration"

    # EKS_VERSION_GUARD_BEGIN
    eks_version=$(resolve_setup_eks_version "$ENV_DIR" "$REGION") || {
        error "Unable to determine the target EKS cluster version. Aborting rather than risking an unattended downgrade (see the warning above for the reason)." && echo ""
        exit 1
    }
    # EKS_VERSION_GUARD_END

    cat <<EOF > "$ENV_DIR/env.tfvars"
environment = {
  cluster_role_arns = $role_arns
  region = "$REGION"
  security_groups = [$ssh_security_group]
  ssh_key_name = "$ssh_key"
  stage = "prod"
  subnets = $subnets
  vpc_id = "$vpc_id"
}

environment_internal = {
  eks_version = "$eks_version"
}

storage = {
  driver = "$STORAGE_DRIVER"
}

app_irsa_s3_buckets                  = $s3_buckets_hcl
app_irsa_sqs_queues                  = $sqs_queues_hcl
cluster_endpoint_public_access_cidrs = $access_cidrs_hcl
EOF

if ! $SEARCH; then
    cat <<EOF >> "$ENV_DIR/env.tfvars"

cluster = {
  autoscale        = true
  environment      = "aws"
  has_nvidia       = false
  internet_access  = true
  kube_config_path = "~/.kube/config"
  nodes            = {
    cpu_memory     = "eyelevel-cpu-memory"
    cpu_only       = "eyelevel-cpu-only"
    gpu_layout     = "eyelevel-gpu-layout"
    gpu_ranker     = "eyelevel-gpu-ranker"
    gpu_summary    = "eyelevel-gpu-summary"
  }
  prefix           = "eyelevel"
  pv               = {
    name           = "eyelevel-pv"
    type           = "$STORAGE_DRIVER"
  }
  search           = $SEARCH
  throughput       = {
    ingest         = {
      baseline     = 9600
      max          = 25000
    }
    search         = {
      baseline     = 400000
      max          = 3600000
    }
  }
  type             = "eks"
}

node_replicas = {
  cpu_memory = {
    desired_size = null
    min_size     = null
    max_size     = null
  }
  cpu_only = {
    desired_size = 3
    min_size     = 3
    max_size     = null
  }
  gpu_layout = {
    desired_size = null
    min_size     = null
    max_size     = null
  }
  gpu_ranker = {
    desired_size = 0
    min_size     = 0
    max_size     = 0
  }
  gpu_summary = {
    desired_size = null
    min_size     = null
    max_size     = null
  }
}
EOF
fi

if [[ "${TAG:-}" == "chainguard" ]]; then
  cat <<'EOF' >> "$ENV_DIR/env.tfvars"

deployment_type = {
  min_pv = 120
  tag    = "chainguard"
  user   = 65532
}
EOF
fi

    "$do" "eks" "-t" 2>&1 | tee tf_output.log

    if [[ $? -ne 0 ]]; then
        error "Terraform apply failed. Check tf_output.log for details." && echo ""
        exit 1
    fi

    cleaned_log=$(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log)

    if echo "$cleaned_log" | grep -Eq "Warning|Error"; then
        error "Terraform apply encountered warnings and/or errors. Check tf_output.log for details." && echo ""
        exit 1
    fi
    if grep -q "Warning" <(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log); then
        error "Terraform apply encountered warnings. Check tf_output.log for details." && echo ""
        exit 1
    fi

    ok && echo ""
    status "creating EKS cluster" && echo ""

    "$do" "eks" 2>&1 | tee tf_output.log

    if [[ $? -ne 0 ]]; then
        error "Terraform apply failed. Check tf_output.log for details." && echo ""
        exit 1
    fi

    cleaned_log=$(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log)

    if echo "$cleaned_log" | grep -Eq "Warning|Error"; then
        error "Terraform apply encountered warnings and/or errors. Check tf_output.log for details." && echo ""
        exit 1
    fi
    if grep -q "Warning" <(sed -r "s/\x1B\[[0-9;]*[mK]//g" tf_output.log); then
        error "Terraform apply encountered warnings. Check tf_output.log for details." && echo ""
        exit 1
    fi

    storage_driver=$(terraform -chdir="$ENV_DIR/eks" output -raw storage_driver 2>/dev/null)
    storage_class_name=$(terraform -chdir="$ENV_DIR/eks" output -raw storage_class_name 2>/dev/null)
    storage_access_mode=$(terraform -chdir="$ENV_DIR/eks" output -raw storage_access_mode 2>/dev/null)
    efs_file_system_id=$(terraform -chdir="$ENV_DIR/eks" output -raw efs_file_system_id 2>/dev/null)

    chart_dir="$ENV_DIR/../../src/groundx"
    storage_values="$chart_dir/prereqs/storageclass/values.aws.local.yaml"
    app_values="$chart_dir/values.aws.local.yaml"

    if [[ "$storage_driver" == "efs" ]]; then
        if [[ -z "$efs_file_system_id" ]]; then
            error "EFS storage selected but efs_file_system_id Terraform output is empty." && echo ""
            exit 1
        fi
        cat <<EOF > "$storage_values"
storageClassName: ${storage_class_name:-eyelevel-pv}
isDefaultClass: false

provisioner: efs.csi.aws.com

reclaimPolicy: Retain
parameters:
  provisioningMode: efs-ap
  fileSystemId: $efs_file_system_id
  directoryPerms: "700"
  basePath: /eyelevel
EOF
    else
        cat <<EOF > "$storage_values"
storageClassName: ${storage_class_name:-eyelevel-pv}
isDefaultClass: true

provisioner: ebs.csi.aws.com

reclaimPolicy: Delete
parameters:
  type: gp3
EOF
    fi

    cat <<EOF > "$app_values"
cluster:
  pvClass: ${storage_class_name:-eyelevel-pv}
  pvAccessMode: ${storage_access_mode:-ReadWriteMany}

workspace:
  enabled: true
  existingSecret: eyelevel-secret-credentials
  pvc:
    name: workspace-data
    capacity: 50Gi
EOF

    ok && echo "" && ok "VPC and Cluster setup complete. You can now set up the EyeLevel operator" && echo "" && echo ""
    echo "Generated Helm values:"
    echo "  $storage_values"
    echo "  $app_values"
    echo ""
    echo "Next Helm commands:"
    echo "helm upgrade --install groundx-secret src/groundx/prereqs/secret -f values.extract.eks.secret.yaml"
    echo "helm upgrade --install groundx-storageclass src/groundx/prereqs/storageclass -f src/groundx/prereqs/storageclass/values.aws.local.yaml"
    echo "helm upgrade --install groundx src/groundx -f values.extract.eks.yaml -f src/groundx/values.aws.local.yaml"
fi
